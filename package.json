{
  "name": "lore-path-of-exile",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c yellow,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "build:campaign": "node scripts/build-campaign.mjs",
    "copy:audio": "node scripts/copy-audio.mjs",
    "fetch:portraits": "node scripts/fetch-portraits.mjs",
    "capture": "node scripts/capture-screens.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
